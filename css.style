@charset "UTF-8"; 

/* --- 1. CONFIGURAÇÕES GERAIS E RESETS --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box; /* Impede que paddings quebrem as larguras */
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

body {
    background-color: #ebebeb; /* Cinza claro de fundo do Mercado Livre */
    color: #333;
}

/* --- 2. CABEÇALHO (HEADER) --- */
header {
    background-color: #b2ac6d; /* Amarelo clássico da marca */
    padding: 10px 0;
    box-shadow: 0 1px 2px 0 rgba(0,0,0,0.1);
    position: sticky; /* Mantém o menu preso no topo ao rolar a página */
    top: 0;
    z-index: 100;
}

.header-container {
    max-width: 1200px; /* Limita a largura em telas muito grandes */
    margin: 0 auto; /* Centraliza o container */
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
}

.logo {
    font-size: 20px;
    font-weight: bold;
    color: #2d3277; /* Azul marinho das letras antigas/identidade */
    text-decoration: none;
}

/* --- 3. BARRA DE PESQUISA --- */
.search-box {
    flex: 1; /* Faz a barra ocupar todo o espaço do meio disponível */
    margin: 0 30px;
    display: flex;
    position: relative;
}

.search-box input {
    width: 100%;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    box-shadow: 0 1px 2px 0 rgba(0,0,0,0.2);
    outline: none; /* Remove a borda preta padrão ao clicar */
}

.search-box button {
    position: absolute; /* Posiciona o ícone de lupa dentro do input */
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: none;
    cursor: pointer;
    font-size: 16px;
}

.cart-status {
    font-size: 14px;
    color: #333;
}

/* --- 4. ÁREA DOS PRODUTOS (GRID) --- */
main {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
}

.section-title {
    font-size: 24px;
    font-weight: 300;
    color: #666;
    margin-bottom: 20px;
}

.products-grid {
    display: grid;
    /* Mágica da responsividade: cria colunas automáticas de no mínimo 220px */
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px; /* Espaçamento entre os cards */
}

/* --- 5. CARTÃO DE PRODUTO INDIVIDUAL --- */
.product-card {
    background-color: #fff;
    border-radius: 4px;
    overflow: hidden; /* Garante que as bordas arredondadas cortem o conteúdo */
    box-shadow: 0 1px 2px 0 rgba(0,0,0,0.1);
    transition: transform 0.2s, box-shadow 0.2s; /* Suaviza a animação do hover */
    cursor: pointer;
    display: flex;
    flex-direction: column;
}

/* Efeito de "levantar" o card ao passar o mouse */
.product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 7px 16px 0 rgba(0,0,0,0.11);
}

.product-image {
    width: 100%;
    height: 200px;
    background-color: #f7f7f7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px; /* Controla o tamanho do emoji */
}

.product-info {
    padding: 15px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* Empurra o botão "Adicionar" para o rodapé do card */
}

.product-price {
    font-size: 22px;
    font-weight: 400;
    color: #333;
    margin-bottom: 8px;
}

.product-shipping {
    color: #00a650; /* Verde característico de frete grátis do ML */
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 8px;
}

.product-title {
    font-size: 14px;
    color: #666;
    line-height: 1.3;
    
    /* Corta o texto em no máximo 2 linhas e adiciona "..." caso seja muito longo */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Botão de Compra/Adicionar */
.btn-buy {
    width: 100%;
    background-color: #3483fa; /* Azul padrão dos botões do ML */
    color: white;
    border: none;
    padding: 8px;
    border-radius: 4px;
    margin-top: 10px;
    cursor: pointer;
    font-weight: 600;
    transition: background-color 0.2s;
}

.btn-buy:hover {
    background-color: #2968c8; /* Tom de azul mais escuro no hover */
}
